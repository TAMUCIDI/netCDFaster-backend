# Flask environment (production or development)
FLASK_ENV=production

# Security: Generate a strong random secret key for production
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-replace-with-random-string

# URL prefix for the application
# The application will be accessible at: http://<ip><URL_PREFIX>/
# Example: URL_PREFIX=/netcdfaster-backend -> http://<ip>/netcdfaster-backend/file/upload
URL_PREFIX=/netcdfaster-backend

# CORS configuration: comma-separated list of allowed origins
# Example: CORS_ORIGINS=http://example.com,https://example.com
CORS_ORIGINS=http://localhost:3000

# Session cookie settings (automatically set based on FLASK_ENV in production)
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

# Redis URL for session storage (required)
# For Upstash: rediss://default:<password>@<host>:<port>
# For local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Upload folder for file storage
UPLOAD_FOLDER=uploads

# Model path (if needed)
MODEL_JSON_PATH=app/model/CatBoost_500_16.json